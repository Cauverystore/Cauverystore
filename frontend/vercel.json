{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": [
      "/((?!api|static|favicon.ico|manifest.json|robots.txt|service-worker.js|.*\\.(?:png|jpg|jpeg|svg|ico|css|js|map|json|webp|woff2?)).*)"
    ]
  }
}
