# Copy to .env for running on your own PC. On Railway set these as Variables instead.

# The store backend, and the same secret as AGENTS_TOKEN on the store's Railway service.
STORE_API_URL=http://localhost:9091
AGENTS_TOKEN=change-me-to-a-long-random-secret

# ONLY for the optional rented-AI setup (Dockerfile.hosted). The default own-brain setup
# (Dockerfile.ownbrain) sets these itself and needs no key.
# Any OpenAI-compatible AI provider. Examples:
#   Google Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=<a Gemini model name>
#   Groq:          AI_BASE_URL=https://api.groq.com/openai/v1                         AI_MODEL=<a Groq model name>
#   OpenAI:        AI_BASE_URL=https://api.openai.com/v1                              AI_MODEL=<an OpenAI model name>
#   Ollama (own):  AI_BASE_URL=http://localhost:11434/v1                              AI_MODEL=<a model you pulled>
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# How many queued links one run handles (1-50).
AGENT_BATCH_SIZE=10
