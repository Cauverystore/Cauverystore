{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/gst-importer/**"
    ]
  },
  "deploy": {
    "startCommand": "python gst_master_importer.py --trigger cron",
    "restartPolicyType": "NEVER"
  }
}
