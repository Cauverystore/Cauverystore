# Copy to .env and fill in. The importer reads these (env vars win over .env).

# --- Database (same Postgres as the store; tables are gst_importer_* so no clash) ---
# Prefer DATABASE_URL (Railway style), otherwise set the PG* vars:
#DATABASE_URL=postgresql://user:password@host:5432/dbname
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=root

# --- Sources ---
GST_MASTER_CODES_URL=https://einvoice1.gst.gov.in/Others/MasterCodes
# Official HSN+SAC list and CBIC rate seed. In dev, point at the repo copies;
# the packaged exe bundles them under data/ automatically.
GST_HSN_FILE=..\backend-java\src\main\resources\master-data\hsn_master.json
GST_RATES_FILE=..\backend-java\src\main\resources\master-data\gst_rate_seed.json
# Optional live URLs (used only when the *_FILE path does not exist):
#GST_HSN_URL=https://.../hsn_master.json
#GST_RATES_URL=https://.../gst_rate_seed.json

# --- Flask API ---
GST_IMPORTER_HOST=127.0.0.1
GST_IMPORTER_PORT=5001
GST_IMPORTER_API_TOKEN=
# Comma-separated origins allowed to call the API from the browser:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Path to the packaged executable. Empty => the API runs the script with python.
GST_IMPORTER_EXE=
GST_IMPORTER_TIMEOUT=600
# Log file for the API/cron (cron wrapper also logs to /var/log/gst_master_update.log).
#GST_IMPORTER_LOG_FILE=/var/log/gst_master_update.log
